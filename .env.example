# AI for the Chogs' voices, the nightly gossip and the debates. Set ONE of these.
# Without either, Chogtown runs on scripted lines.
# Claude (paid, best characters):
ANTHROPIC_API_KEY=
# xAI Grok (console.x.ai; used when ANTHROPIC_API_KEY is empty):
XAI_API_KEY=
# Optional: Grok model (default grok-4.3)
XAI_MODEL=
# Groq (free plan at console.groq.com, no card; used when both keys above are empty):
GROQ_API_KEY=
# Optional: Groq model (default openai/gpt-oss-120b)
GROQ_MODEL=
# Optional: override the model (default claude-haiku-5-5, the cheapest; claude-opus-5-5 writes richer characters at higher cost)
CHOG_MODEL=

# Signs the session cookie. Any long random string.
SESSION_SECRET=

# Persistence. Without these, data lives in server memory and resets on restart.
# Any Postgres (the table is created on first use):
DATABASE_URL=
# or Supabase (run supabase/schema.sql once):
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Protects /api/cron/night. Vercel Cron sends it automatically when set in the project.
CRON_SECRET=

# Optional: a judge pass at /api/judge?code=<JUDGE_CODE> lets a browser play any Chog like a holder
JUDGE_CODE=

# Optional
MONAD_RPC_URL=https://rpc.monad.xyz
# RPC for the Chog Genesis Transfer watcher (reads logs in 100-block ranges)
MONAD_LOGS_RPC_URL=https://rpc3.monad.xyz
IPFS_GATEWAY=https://ipfs.io/ipfs/
# Local testing only: lets any wallet claim any Chog when the Monad RPC can't be reached.
ALLOW_UNVERIFIED_CLAIMS=

# Optional: a modelled Chog (.glb) that replaces the built-in 3D Chogs, e.g. /chog.glb placed in public/
NEXT_PUBLIC_CHOG_GLB=

# Demo and testing only
# How often a Main Event rings by itself, in ms (default 6 minutes)
AUTO_MAIN_MS=
# 1 lets /api/live/act replay a given Chog Transfer (for recording demos)
DEMO_REPLAY=
